<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/travelshare_create_screen_title"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSelectedPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_photo_post_card"
            android:contentDescription="@string/travelshare_selected_photo_preview"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <Button
            android:id="@+id/btnSelectPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/travelshare_select_photo_button" />

        <EditText
            android:id="@+id/etCreateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/travelshare_create_title_hint"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etCreateDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="top|start"
            android:hint="@string/travelshare_create_description_hint"
            android:inputType="textMultiLine"
            android:minHeight="110dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/travelshare_voice_note_section"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVoiceNoteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_photo_post_card"
            android:padding="12dp"
            android:text="@string/travelshare_voice_note_empty"
            android:textColor="#64748B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecordVoiceNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/travelshare_voice_note_record_button" />

            <Button
                android:id="@+id/btnPlayVoiceNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/travelshare_voice_note_play_button" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDeleteVoiceNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/travelshare_voice_note_delete_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/travelshare_group_picker_label"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/travelshare_place_section"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedPlaceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_bar"
            android:padding="12dp"
            android:text="@string/travelshare_place_not_selected"
            android:textStyle="bold"
            android:textColor="#475569" />

        <TextView
            android:id="@+id/tvSelectedPlaceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_photo_post_card"
            android:padding="12dp"
            android:text="@string/travelshare_place_details_empty"
            android:textColor="#64748B" />

        <AutoCompleteTextView
            android:id="@+id/actvCreatePlaceSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:completionThreshold="2"
            android:hint="@string/travelshare_place_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etCreateTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/travelshare_create_tags_hint"
            android:padding="12dp" />

        <Spinner
            android:id="@+id/spinnerCreatePlaceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAnnotationAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#D8E1EA"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/travelshare_annotation_section"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnnotationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/travelshare_annotation_subtitle"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressAnnotation"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAnnotationSummaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/travelshare_annotation_summary_label"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnnotationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_photo_post_card"
                    android:padding="12dp"
                    android:text="@string/travelshare_annotation_empty_state"
                    android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvAnnotationTagsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/travelshare_annotation_tags_label"
                    android:textColor="#334155"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnnotationTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_photo_post_card"
                    android:padding="12dp"
                    android:text="@string/travelshare_annotation_empty_state"
                    android:textColor="#475569" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyAnnotation"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="@string/travelshare_annotation_apply_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnPublishPhotoMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/travelshare_create_publish_button" />

    </LinearLayout>

</ScrollView>
