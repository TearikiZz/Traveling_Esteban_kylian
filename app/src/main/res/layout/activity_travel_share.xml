<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTravelShareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/travelshare_screen_title"
                android:textColor="#1E293B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTravelShareSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="@string/travelshare_screen_subtitle"
                android:textColor="#475569"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivProfileShortcut"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_profile_avatar"
            android:clickable="true"
            android:clipToOutline="true"
            android:contentDescription="@string/profile_open_button"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="#0F172A"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCreatePhotoMetadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/travelshare_create_post_button"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnOpenGroups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/travelshare_groups_button" />

    <Button
        android:id="@+id/btnToggleFeedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/travelshare_feed_grid_button" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchPhotoMetadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/travelshare_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnVoiceSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/travelshare_voice_search_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTravelShareFilters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/travelshare_filters_section"
        android:textColor="#334155"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerFilterPlaceType"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <Spinner
                android:id="@+id/spinnerFilterAuthor"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp" />

            <Spinner
                android:id="@+id/spinnerFilterPeriod"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/btnResetFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/travelshare_filter_reset_button" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPhotoMetadata"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
